{
  "name": "viz-light",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=24.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer",
      "unrs-resolver"
    ]
